    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "skyrpg_core": "*",
    "skyrpg_vfx": "*"
  },
  "mixins": [
    {
      "config": "skyrpg_pets.client.mixins.json",
      "environment": "client"
    }
  ]
