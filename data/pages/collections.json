tat"}]],"rows":[[[{"x":"Blaze Rod","item":"minecraft:blaze_rod","icon":"minecraft:blaze_rod"}],[{"x":"40"}],[{"x":"40,000"}],[{"x":"150 to 45,000 (91,275 in all)"}],[{"x":"Strength"}]],[[{"x":"Bone","item":"minecraft:bone","icon":"minecraft:bone"}],[{"x":"100"}],[{"x":"100,000"}],[{"x":"100 to 30,000 (60,850 in all)"}],[{"x":"Defense"}]],[[{"x":"Ender Pearl","item":"minecraft:ender_pearl","icon":"minecraft:ender_pearl"}],[{"x":"30"}],[{"x":"30,000"}],[{"x":"200 to 60,000 (121,700 in all)"}],[{"x":"Intelligence"}]],[[{"x":"Gunpowder","item":"minecraft:gunpowder","icon":"minecraft:gunpowder"}],[{"x":"75"}],[{"x":"75,000"}],[{"x":"100 to 30,000 (60,850 in all)"}],[{"x":"Strength"}]],[[{"x":"Rotten Flesh","item":"minecraft:rotten_flesh","icon":"minecraft:rotten_flesh"}],[{"x":"100"}],[{"x":"100,000"}],[{"x":"100 to 30,000 (60,850 in all)"}],[{"x":"Health"}]],[[{"x":"Slime","item":"minecraft:slime_ball","icon":"minecraft:slime_ball"}],[{"x":"50"}],[{"x":"50,000"}],[{"x":"100 to 30,000 (60,850 in all)"}],[{"x":"Health"}]],[[{"x":"Spider Eye","item":"minecraft:spider_eye","icon":"minecraft:spider_eye"}],[{"x":"50"}],[{"x":"50,000"}],[{"x":"100 to 30,000 (60,850 in all)"}],[{"x":"Crit Damage"}]],[[{"x":"String","item":"minecraft:string","icon":"minecraft:string"}],[{"x":"75"}],[{"x":"75,000"}],[{"x":"100 to 30,000 (60,850 in all)"}],[{"x":"Speed"}]],[[{"x":"Valor Mark","item":"skyrpg_combat:valor_mark","icon":"skyrpg_combat:valor_mark","color":"#55FF55"}],[{"x":"25"}],[{"x":"25,000"}],[{"x":"200 to 60,000 (121,700 in all)"}],[{"x":"Magic Find"}]]],"align":["l","l","l","l","l"]},{"t":"h2","text":"The SkyRPG Level","anchor":"the-skyrpg-level"},{"t":"p","s":[{"x":"The SkyRPG Level is your overall progress. It has "},{"x":"no cap","b":true},{"x":", and it is "},{"x":"100 SkyRPG XP for every level","b":true},{"x":"."}]},{"t":"h3","text":"Where SkyRPG XP comes from","anchor":"where-skyrpg-xp-comes-from"},{"t":"table","head":[[{"x":"Source"}],[{"x":"XP"}]],"rows":[[[{"x":"Each collection tier"}],[{"x":"4"}]],[[{"x":"Each skill level"}],[{"x":"5"}]],[[{"x":"Each slayer level"}],[{"x":"10"}]],[[{"x":"First clear of a dungeon (its champion's first kill)"}],[{"x":"20 to 60, by how tough the dungeon is"}]],[[{"x":"First kill of any other boss"}],[{"x":"15"}]],[[{"x":"Quest rewards"}],[{"x":"Varies by quest"}]]],"align":["l","l"]},{"t":"p","s":[{"x":"The dungeon bonus is 20 for a champion below level 25, 30 below 40, 40 below 52, 50 below 62 and 60 from there. It is paid once for each boss, per player."}]},{"t":"p","s":[{"x":"The most SkyRPG Level a player can reach, and how much of it each source gives, is on "},{"x":"SkyRPG Level: the maximum","link":"skyrpg-level-max"},{"x":"."}]},{"t":"h3","text":"Level rewards","anchor":"level-rewards"},{"t":"ul","items":[{"s":[{"x":"Every level shows \"SkyRPG Level N\" above your hotbar."}]},{"s":[{"x":"Every 10th level pays coins","b":true},{"x":": 500 coins times the level. Level 10 pays 5,000, level 20 pays 10,000, level 50 pays 25,000. You also get a notice and the level-up effect."}]}]},{"t":"h3","text":"Where it shows","anchor":"where-it-shows"},{"t":"ul","items":[{"s":[{"x":"The header of your Profile page."}]},{"s":[{"x":"The "},{"x":"level badge","b":true},{"x":" before your name in chat and in the Tab list, in a colour that changes every 40 levels: grey (0 to 39), white, yellow, green, dark green, aqua, dark aqua, blue, pink, purple, gold, red, and dark red from level 480. Hover a badge to see what the next colour is."}]},{"s":[{"x":"Other players can see it, since it is shared with everyone."}]}]},{"t":"p","s":[{"x":"Several Chronicle quests ask for a SkyRPG Level: 2, 5, 9, 20 and 35. See "},{"x":"Quests and the Journal","link":"quests-and-journal"},{"x":"."}]},{"t":"h2","text":"Tips","anchor":"tips"},{"t":"callout","kind":"tip","b":[{"t":"p","s":[{"x":"Early collections go fast, and they feed your first Artisan Bench recipes. Start with what you gather anyway: stone, coal, wood and crops."}]}]},{"t":"callout","kind":"tip","b":[{"t":"p","s":[{"x":"Rare materials have small thresholds. A Lumenite or Hellforged Scrap collection reaches tier I at only 15 items."}]}]},{"t":"callout","kind":"note","b":[{"t":"p","s":[{"x":"Collections count what "},{"x":"you","b":true},{"x":" gather. A friend who gives you materials does not move your collection."}]}]},{"t":"h2","text":"See also","anchor":"see-also"},{"t":"ul","items":[{"s":[{"x":"Quests and the Journal","link":"quests-and-journal"}]},{"s":[{"x":"Crafting","link":"crafting"}]},{"s":[{"x":"K menu","link":"k-menu"}]},{"s":[{"x":"Chat","link":"chat"}]},{"s":[{"x":"Collection list","link":"collection-list"}]}]}]}